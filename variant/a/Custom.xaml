                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%86%94%E5%B2%A9" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 酿造台" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="无论玩家朝向什么方向放置，酿造台总是面向东方。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 鸡" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在愚人节版本Java版2.0中，加入了下钻石和青金石的钻石鸡。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 潜影贝" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="当玩家站在潜影贝的壳上时，可以潜行并且不会掉下来，就像站在方块上一样。如果外壳往侧向打开，则相当于一级垂直的台阶，玩家仍然可以站在上面并且不会掉落下来，除非壳关闭了。" />
