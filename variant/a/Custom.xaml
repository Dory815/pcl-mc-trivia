                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%BC%8F%E6%96%97" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 掠夺者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="掠夺者和弩来源自Minecraft Dungeons，尽管它们最先被实装进Minecraft中。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. Eld Unknown" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="曲名“Eld Unknown”中的“Eld”可能是英语单词“old”（古老的）的古语形式。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 击打" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="32px 在26w14a的官方预告片中，玩法演示画面使用了未实装的击打纹理。" />
