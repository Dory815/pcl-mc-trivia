                                Foreground="#4A8CF7" Text="3. Minecraft World"
                                ToolTip="https://zh.minecraft.wiki/w/Minecraft_World"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/Minecraft_World" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 玩家" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在Steam版本的游戏《超级食肉男孩》中，Steve是一个以“Mr. Minecraft”为名称的可解锁角色。它比其他角色跳的低，并且可以在平台的水平面上开挖和放置它们。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 铜制号角" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="同种铜制号角在仰头和平视时吹奏所发出的声音是同一段音频的高音和低音版本。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 钻石块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="钻石块与金块的纹理只有颜色不同，纹理更新前也是如此。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
