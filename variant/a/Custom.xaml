                                Foreground="#4A8CF7" Text="1. 甘蔗"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%94%98%E8%94%97"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%94%98%E8%94%97" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 运输船"
                                ToolTip="https://zh.minecraft.wiki/w/%E8%BF%90%E8%BE%93%E8%88%B9"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E8%BF%90%E8%BE%93%E8%88%B9" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 狼"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%8B%BC"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8B%BC" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 多重射击" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="带有高等级多重射击的弩射出的箭的初速度方向在同一平面内，形成的圆形所在平面的倾斜角与玩家的俯仰角相同，即向后方向射出的箭沿视线的反方向；而在Java版中带有高等级多重射击的弓射出的箭的初速度方向组成一个圆锥面，即向后方向射出的箭不一定沿视线的反方向。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. TNT" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="矛的近战攻击可以击退被激活的TNT，甚至可以使用击退附魔让其被击退得更远。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 高草丛" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="高草丛不能被直接点燃，然而在其旁边的火却可以传播到它。蔓延到高草丛上方的火看起来是浮空的。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 多重射击"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%A4%9A%E9%87%8D%E5%B0%84%E5%87%BB"
