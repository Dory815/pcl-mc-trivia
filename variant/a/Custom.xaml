                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 木门"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%9C%A8%E9%97%A8"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%9C%A8%E9%97%A8" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 剑"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%89%91"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%89%91" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 凋灵" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="据Jeb说，凋灵的设计灵感来自《泰拉瑞亚》中玩家主动召唤boss的机制。“Wither”这个名字则来源于Whispers in Akarra（Jeb制作的一个游戏）里的一个中-{}-毒咒语。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 猫" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="对着已驯服的猫猫刷怪蛋，生成的幼年猫也是已驯服的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 末影人" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="另外，在Minecraft: Story Mode第三章「3」中，当Lukas询问末影人的量词时玩家操纵的角色需要正确指定末影人的集合名词“a haunting of Endermen”（游戏内称“一大群阴魂不散的末影人”）的语法顺序，这支持了Dinnerbone的说法。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 凋灵"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%87%8B%E7%81%B5"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%87%8B%E7%81%B5" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 猫"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%8C%AB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8C%AB" />
