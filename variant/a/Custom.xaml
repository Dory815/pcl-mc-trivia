                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. Debug fourj item"
                                ToolTip="https://zh.minecraft.wiki/w/Debug_fourj_item"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/Debug_fourj_item" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
