                                ToolTip="https://zh.minecraft.wiki/w/%E9%B8%A1"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%B8%A1" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 鞘翅"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%9E%98%E7%BF%85"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%9E%98%E7%BF%85" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 猫（25w14craftmine）"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%8C%AB%EF%BC%8825w14craftmine%EF%BC%89"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8C%AB%EF%BC%8825w14craftmine%EF%BC%89" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 箭" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="箭实体的实际朝向与模型的旋转角度在数值上为相反数关系。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 重生锚" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="重生锚的光照等级与比较器给出的红石信号强度一致。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 珊瑚扇" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="珊瑚扇不是固体方块，但失活的珊瑚扇是。" />
