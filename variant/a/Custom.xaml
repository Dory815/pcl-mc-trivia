                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%B4%BB%E5%A1%9E" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 掠夺者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="掠夺者被添加到村庄和掠夺中是为了给村民一个“真正的”对手，以平衡新的村庄机制。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 骷髅马" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="骷髅马虽然无法被喂食，但还是会进行低头吃草的动作。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 探险家地图" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在邻近的沉船或海底废墟中找到的藏宝图很可能是相同的。" />
