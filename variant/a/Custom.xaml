                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip5:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 海龟蛋" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="海龟蛋在夜晚孵化速度较快的机制是基于现实设计的。现实中的小海龟在白天容易引来掠食者侵害，因此演化出在较低温度时加速孵化的特性，这样能确保小海龟有更高的概率于夜晚孵化。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 橙色染料" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="橙色染料的颜色与格式化代码中的聊天字体颜色相匹配。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 望远镜" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Java版望远镜是反着拿的，更符合现实生活中的使用习惯。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 海龟蛋"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%B5%B7%E9%BE%9F%E8%9B%8B"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%B5%B7%E9%BE%9F%E8%9B%8B" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 橙色染料"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%A9%99%E8%89%B2%E6%9F%93%E6%96%99"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%A9%99%E8%89%B2%E6%9F%93%E6%96%99" />
