        <Grid>
                    <StackPanel Visibility="{variable:Clip1:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 豹猫" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="豹猫是Jon Kågström创造的第一种生物。Jon Kågström是一名曾与Jeb合作开发Minecraft的AI专家。Jeb帮助制作了豹猫的纹理，因为Jon在制作时遇到了困难。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 猫" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在Java版1.14和基岩版1.10.0前，猫是从豹猫驯服而来的，而现实中的猫是从生活在稀树草原等干旱地带的非洲野猫进化而来的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 苦力怕" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="游戏内有多处出现了苦力怕面部图案，包括：" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· Minecraft徽标的字母A中" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 青色带釉陶瓦的每个面上" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 雕纹砂岩的每个侧面上" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 羊驼身上装备的绿色地毯上" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 牧师村民长袍的背上" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 豹猫"
                                ToolTip="https://zh.minecraft.wiki/w/%E8%B1%B9%E7%8C%AB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E8%B1%B9%E7%8C%AB" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 猫"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%8C%AB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8C%AB" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 苦力怕"
                                ToolTip="https://zh.minecraft.wiki/w/%E8%8B%A6%E5%8A%9B%E6%80%95"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E8%8B%A6%E5%8A%9B%E6%80%95" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 望远镜" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Java版望远镜是反着拿的，更符合现实生活中的使用习惯。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 末影龙" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在Reddit上，Notch用“她”来指代末影龙，并且称呼末影龙为“Jean?”，这种命名方法类似于称呼玩家名字（“Steve?”）" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· Dinnerbone晚些时候表示他认为“Jean?”就是末影龙的官方名称。" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· Xbox头像物品“Ender Dragon Pet”的描述如下：比它的Minecraft姐姐更可爱、更友好、更调皮。这证明了末影龙的性别是雌性。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 旗帜图案" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="宝库战利品是旋风和涡流旗帜图案唯一的可再生获取方式。这是因为宝库可以被每个玩家打开无限次数，且试炼钥匙和不祥试炼钥匙是可再生资源。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 望远镜"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%9C%9B%E8%BF%9C%E9%95%9C"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%9C%9B%E8%BF%9C%E9%95%9C" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 末影龙"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E9%BE%99"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E9%BE%99" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 旗帜图案"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%97%97%E5%B8%9C%E5%9B%BE%E6%A1%88"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%97%97%E5%B8%9C%E5%9B%BE%E6%A1%88" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 劫掠兽" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="劫掠兽的灵感来源于波斯传说生物蝎狮，尤其参考了游戏《龙与地下城》中的蝎狮设计。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 海豚" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="海豚给玩家引路时出现的白色粒子实际上与烟花火箭的尾迹粒子是相同的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 马铃薯油" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="这些药水形式的“马铃薯油”的瓶中液体呈现微微的淡绿色，而非真正的马铃薯油的白色。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 劫掠兽"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%8A%AB%E6%8E%A0%E5%85%BD"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%8A%AB%E6%8E%A0%E5%85%BD" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 海豚"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%B5%B7%E8%B1%9A"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%B5%B7%E8%B1%9A" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 马铃薯油"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%A9%AC%E9%93%83%E8%96%AF%E6%B2%B9"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%A9%AC%E9%93%83%E8%96%AF%E6%B2%B9" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. TNT" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="“TNT”的全称是2,4,6-三硝基甲苯（Trinitrotoluene）。虽然游戏内TNT的合成配方是火药和沙子，但现实中TNT是由甲苯与浓硫酸和浓硝酸的混合物长时间加热反应得到的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 快乐恶魂" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="小恶魂在外观上有鳃，且为双层纹理；成年后的快乐恶魂没有鳃，且为单层纹理。与此对应，小恶魂不会溺水，而快乐恶魂会溺水。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 水桶" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="水桶被数据包的自定义配方作为原材料合成后，会返还铁桶。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. TNT"
                                ToolTip="https://zh.minecraft.wiki/w/TNT"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/TNT" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 快乐恶魂"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%BF%AB%E4%B9%90%E6%81%B6%E9%AD%82"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%BF%AB%E4%B9%90%E6%81%B6%E9%AD%82" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 水桶"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%B0%B4%E6%A1%B6"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%B0%B4%E6%A1%B6" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip5:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. Mice on Venus" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="曲名引用自电子音乐组合火星鼠（Mouse on Mars）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 矛" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版得益于可以触发击退攻击，玩家仅需疾跑即可不断利用冲锋攻击伤害同一个目标。附有至少2级击退魔咒的矛将拥有相似的使用体验。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 铁栏杆" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Java版2×2铁栏杆围成的缝隙可以提供一个足够容纳玩家的空间，但雨、水等则无法穿过。玻璃板也有着同样的效果。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. Mice on Venus"
                                ToolTip="https://zh.minecraft.wiki/w/Mice_on_Venus"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/Mice_on_Venus" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 矛"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%9F%9B"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%9F%9B" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 铁栏杆"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%93%81%E6%A0%8F%E6%9D%86"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%93%81%E6%A0%8F%E6%9D%86" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 旗帜" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="考虑到旗帜图案共42种，染料共16种，旗帜共16种，每个旗帜最多可以有6层图案。因此生存模式下可以做出的不重复的旗帜总数理论值为：16 \times \sum_{k=0}^6 (16 \times 42)^k = 1475646641940097552 \approx 1.47 \times 10^{18}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 末影珍珠" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="通过贴在方块上并不断地向玩家的脚部使用末影珍珠可以让玩家穿过非固体方块。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 潮涌核心" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
