                                Foreground="#4A8CF7" Text="1. 熔炉"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%86%94%E7%82%89"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%86%94%E7%82%89" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 煤炭块"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%85%A4%E7%82%AD%E5%9D%97"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%85%A4%E7%82%AD%E5%9D%97" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
