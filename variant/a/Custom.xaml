                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip5:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 尸壳" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="尸壳是由Jason Mayer在一场游戏制作比赛中创造出来的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 煎炸台" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在24w14potato发布之前，煎炸台的项目标签页曾出现在Minecraft官方发布的合成器介绍视频中，引发玩家社区对新内容的猜测。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 末影龙" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在为末影龙添加纹理之前，Notch说他很害怕为末影龙添加纹理，因为末影龙的模型非常复杂。最后，Notch觉得末影龙的模型实在太复杂，便放弃了手动制作纹理，而用他自己写的纹理打包工具将纹理添加到模型里面。Notch上传了打包工具的代码供他人使用。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 尸壳"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%B0%B8%E5%A3%B3"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%B0%B8%E5%A3%B3" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 煎炸台"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%85%8E%E7%82%B8%E5%8F%B0"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%85%8E%E7%82%B8%E5%8F%B0" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 末影龙"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E9%BE%99"
