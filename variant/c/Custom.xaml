                                ToolTip="https://zh.minecraft.wiki/w/%E8%8A%9D%E5%A3%AB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E8%8A%9D%E5%A3%AB" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 末影龙" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Dinnerbone晚些时候表示他认为“Jean?”就是末影龙的官方名称。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 沙子" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="因为falling_block是一个实体，浮空的沙子方块会在一瞬间消失并生成一个falling_block实体。沙子落地时则反之，实体消失后，沙子方块将被程序放置在新的位置上。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
