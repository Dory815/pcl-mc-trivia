                                Foreground="#4A8CF7" Text="1. 猫（25w14craftmine）"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%8C%AB%EF%BC%8825w14craftmine%EF%BC%89"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8C%AB%EF%BC%8825w14craftmine%EF%BC%89" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
