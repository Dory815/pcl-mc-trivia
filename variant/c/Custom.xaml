                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/TNT" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 雪块"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%9B%AA%E5%9D%97"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%9B%AA%E5%9D%97" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
