                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E8%8B%A6%E5%8A%9B%E6%80%95" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 牡丹"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%89%A1%E4%B8%B9"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%89%A1%E4%B8%B9" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 骆驼"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%AA%86%E9%A9%BC"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%AA%86%E9%A9%BC" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip5:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 潜影贝" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果潜影贝的顶面和侧面存在方块时，会附着到其侧面方块上。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 猫" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在Java版1.14和基岩版1.10.0前，猫是从豹猫驯服而来的，而现实中的猫是从生活在稀树草原等干旱地带的非洲野猫进化而来的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 音符盒" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="默认状态下音符盒的音符起于F♯，然而现实中F♯调的乐器极为罕见。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 潜影贝"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%BD%9C%E5%BD%B1%E8%B4%9D"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%BD%9C%E5%BD%B1%E8%B4%9D" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 猫"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%8C%AB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8C%AB" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 音符盒"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%9F%B3%E7%AC%A6%E7%9B%92"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%9F%B3%E7%AC%A6%E7%9B%92" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 荧光棒" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="黑色荧光棒和淡灰色荧光棒使用与红色荧光棒相同的纹理。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 不祥宝库" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="不祥宝库可以被每个玩家打开无限次数，这与Mojang声称的“每个宝库只能被每个玩家打开一次”相悖。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 下界疣块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="和常见的可以被合成为方块的物品不同，下界疣可以合成下界疣块，但下界疣块不能被拆解成下界疣，故其不能被用来储存下界疣。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
