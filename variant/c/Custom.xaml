                                ToolTip="https://zh.minecraft.wiki/w/TNT"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/TNT" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 熊猫" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在基岩版触控设备上，拿着蛋糕靠近熊猫时不会出现“喂养”按钮。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 钥匙（3D Shareware v1.34）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="这三种钥匙及其作弊码可能是在致敬游戏Doom。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 裂纹石砖" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="当烧炼圆石来修复石头的裂纹时，裂开的石头会变成平滑的。但当烧炼没有裂缝的普通石砖时，它们会变成破裂的变种。这可能参考了2个不同的过程：当岩石受热膨胀时，会导致裂纹的产生，而这会让石砖裂开；而另一种只是简单地烧炼圆石，因此它变回火成岩。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
