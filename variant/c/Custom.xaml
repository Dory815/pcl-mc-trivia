                                ToolTip="https://zh.minecraft.wiki/w/%E5%B1%A0%E5%A4%AB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%B1%A0%E5%A4%AB" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 金胡萝卜" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="金胡萝卜能够制作夜视药水可能是由于现实中胡萝卜对视力的保护作用（内含大量的β-胡萝卜素）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 凋灵玫瑰" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="凋灵玫瑰的英文“Wither Rose”意为凋灵的玫瑰（rose of the Wither）而非凋零的玫瑰（withered rose）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 指南针" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="同理，如果完全精准地移动到与磁石指针绑定的磁石的正上/下方方块中间，则磁石指针会如同磁石被破坏一样随机旋转。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
