                                Foreground="#4A8CF7" Text="2. Mice on Venus"
                                ToolTip="https://zh.minecraft.wiki/w/Mice_on_Venus"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/Mice_on_Venus" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 诡异疣块"
                                ToolTip="https://zh.minecraft.wiki/w/%E8%AF%A1%E5%BC%82%E7%96%A3%E5%9D%97"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E8%AF%A1%E5%BC%82%E7%96%A3%E5%9D%97" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 末影螨" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在14w28a前，末影人传送时有概率生成末影螨。据Dinnerbone所说，这是因为末影人在瞬移过程中穿过了某种“中间维度”，并从中带来了一些“不好的东西”。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 绊线钩" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="若绊线线路中的一个绊线被破坏后迅速插入一个绊线钩，线路东、北侧绊线钩和所有绊线的状态不会更新。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 树苗" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
