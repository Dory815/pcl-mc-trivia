                    <StackPanel Visibility="{variable:Clip7:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 雪" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="即便堆叠到8层，雪也不会破坏相邻的仙人掌。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 监守者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版监守者可以在虚空地板上钻地。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 铜水槽" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="铜水槽的名称是“sink”一词的双关：既指水槽，又喻指需要投入大量资源的游戏内容（游戏开发术语）。" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
