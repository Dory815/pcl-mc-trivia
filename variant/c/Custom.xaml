                                ToolTip="https://zh.minecraft.wiki/w/Moog_City"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/Moog_City" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
