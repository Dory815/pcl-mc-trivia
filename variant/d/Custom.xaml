                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 书架"
                                ToolTip="https://zh.minecraft.wiki/w/%E4%B9%A6%E6%9E%B6"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E4%B9%A6%E6%9E%B6" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 染色玻璃板"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%9F%93%E8%89%B2%E7%8E%BB%E7%92%83%E6%9D%BF"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%9F%93%E8%89%B2%E7%8E%BB%E7%92%83%E6%9D%BF" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip7:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 末影人" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="由于末影人可以搬起和放置雕刻南瓜，末影人可能会在无意间建造出铁傀儡、雪傀儡或铜傀儡，但铁傀儡和雪傀儡仍会试图攻击该末影人。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 盔甲" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Java版猪灵和僵尸村民有特殊的盔甲纹理。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 陶片" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="游戏中陶片的英文曾由Pottery Shard更名为Pottery Sherd。据韦氏词典的解释，尽管在英文语境下shard和sherd基本同义，但考古学上更偏好“sherd”这一词形。即，sherd一词可特指考古发掘出的陶片。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 末影人"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E4%BA%BA"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E4%BA%BA" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 盔甲"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%9B%94%E7%94%B2"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%9B%94%E7%94%B2" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 陶片"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%99%B6%E7%89%87"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%99%B6%E7%89%87" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip8:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 层孔菇" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="若使用命令或基岩版将层孔菇放入玩家或一些人形生物的头盔槽，它会像鸭嘴一样显示于嘴部。可在彩蛋了解更多此类彩蛋。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 降雪" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版和雨类似，雪最低也能落到虚空里一格（Y=-65）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 三叉戟" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="创造模式下三叉戟也可以附上锋利、亡灵杀手和节肢杀手。这些魔咒会对相应的生物起作用，包括近战攻击和投掷出去命中末影龙以外的生物。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 层孔菇"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%B1%82%E5%AD%94%E8%8F%87"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%B1%82%E5%AD%94%E8%8F%87" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 降雪"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%99%8D%E9%9B%AA"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%99%8D%E9%9B%AA" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 三叉戟"
                                ToolTip="https://zh.minecraft.wiki/w/%E4%B8%89%E5%8F%89%E6%88%9F"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E4%B8%89%E5%8F%89%E6%88%9F" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip9:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 烟火之星" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="使用钻石合成的烟火之星必须通过宝库战利品才能实现可再生。这是因为钻石同样依赖宝库战利品实现可再生，而宝库可以被每个玩家打开无限次数，且试炼钥匙和不祥试炼钥匙是可再生资源。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 基岩" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="这张纹理用于Classic版本中地图外层的基岩贴图，而不是基岩方块。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 毒马铃薯油" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="虽然毒马铃薯油拥有与药水相似的外观和功能，但毒马铃薯油的ID与药水不同，其也不存在“喷溅型毒马铃薯油”和“滞留型毒马铃薯油”物品。" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 在创造模式物品栏中可以找到名为“毒马铃薯油”的物品以及其喷溅型和滞留型变种。但这些物品的ID为potion，即它们是具有毒马铃薯油药水效果的药水。因此这些物品也不能被用来烧炼获得毒树脂。" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 这些药水形式的“毒马铃薯油”的瓶中液体呈现微微的淡绿色，而非真正的毒马铃薯油的白色。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 烟火之星"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%83%9F%E7%81%AB%E4%B9%8B%E6%98%9F"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%83%9F%E7%81%AB%E4%B9%8B%E6%98%9F" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 基岩"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%9F%BA%E5%B2%A9"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%9F%BA%E5%B2%A9" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 毒马铃薯油"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%AF%92%E9%A9%AC%E9%93%83%E8%96%AF%E6%B2%B9"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%AF%92%E9%A9%AC%E9%93%83%E8%96%AF%E6%B2%B9" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip10:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 狼" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="狼新的音效变种是来自Mojang Studios的音效师Sandra Karlsson在一家狗狗日托中心所录下的狗的叫声。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 物品展示框" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="由于物品展示框属于实体，旁观模式下的玩家可以进入物品展示框的视角。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 溺尸" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在白天，溺尸需要浸在水中才能主动攻击目标。即使是手持三叉戟的溺尸，不在水中时哪怕在阴影处也不会对射程内的攻击目标投掷三叉戟，直到自己或者被攻击才会进行反击。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 狼"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%8B%BC"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8B%BC" />
