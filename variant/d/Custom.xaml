                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%A9%AC%E9%93%A0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 灵魂火" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="灵魂火的外焰和内焰使用两种不同的纹理，这与普通的火相同。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 煎炸台" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在24w14potato发布之前，煎炸台的项目标签页曾出现在Minecraft官方发布的合成器介绍视频中，引发玩家社区对新内容的猜测。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 呼吸" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="要受到溺水或脱水伤害，生物的氧气值必须等于-20。更改生物的实体数据将氧气值设置为比-20更低的值会使其氧气值持续下降，而不会造成伤害或使氧气值变为0。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
