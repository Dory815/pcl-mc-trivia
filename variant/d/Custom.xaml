                                ToolTip="https://zh.minecraft.wiki/w/%E6%BA%BA%E5%B0%B8"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%BA%BA%E5%B0%B8" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 矛"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%9F%9B"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%9F%9B" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 铁砧" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="因为高爆炸抗性的关系，铁砧无法用于水下TNT爆破技巧。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 钓鱼竿" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="玩家最远能把钓鱼竿浮漂抛出33格。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 恶魂" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="恶魂的英文名称“Ghast”源于“Ghastly”（可怕的）。“Ghast”一词用作怪物名称是由H·P·洛夫克拉夫特首创的，后广泛出现在各种奇幻故事和游戏中。" />
