                                ToolTip="https://zh.minecraft.wiki/w/%E7%8C%AA"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8C%AA" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 烟花棒" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="耐久魔咒和不可破坏标签（目前用修改器可获得）对烟花棒无效，但是如果让烟花棒被其他实体拾取、丢弃为物品实体的形式都可以暂停烟花棒的耐久度消耗，而且经验修补魔咒也对烟花棒有效。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 鹦鹉" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="由于苦力怕没有空闲音效也没有脚步声，当鹦鹉检测到附近的苦力怕时只能模仿它引爆时的音效。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 玩家" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在游戏《创造世界》（Createrria: craft your games）里，角色“Mr.Pixel”有着和Steve相似的面部。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
