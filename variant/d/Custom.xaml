                                ToolTip="https://zh.minecraft.wiki/w/%E5%B8%82%E5%9C%BA"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%B8%82%E5%9C%BA" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. Ancestry" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="该曲目虽然包含在专辑Minecraft: Caves &amp; Cliffs (Original Game Soundtrack)中，但并没有在洞穴与山崖被加入游戏，而是在荒野更新中被加入游戏。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 猫" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="白猫的皮肤外观基于泰国御猫，泰国的一个稀有猫品种。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 村民" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="村民的灵感来源于《迷宫魔兽2》中的店主。" />
