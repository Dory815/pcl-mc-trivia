                                ToolTip="https://zh.minecraft.wiki/w/%E6%B5%B7%E9%BE%9F"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%B5%B7%E9%BE%9F" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 光源方块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版光源方块和元素的纹理分辨率都为32&amp;times;32。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 山羊角" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="山羊角的音效是用长木管（类似于迪吉里杜管）录制的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 苦力怕" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="T恤衫，其中苦力怕解剖图T恤衫展示了苦力怕的内部结构，还写上了苦力怕的拉丁文学名：Creepus Explodus；" />
