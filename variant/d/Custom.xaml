                                Foreground="#4A8CF7" Text="1. 硫磺史萊姆桶"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%A1%AB%E7%A3%BA%E5%8F%B2%E8%90%8A%E5%A7%86%E6%A1%B6"
