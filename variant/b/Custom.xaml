                                ToolTip="https://zh.minecraft.wiki/w/%E9%93%81%E6%A1%B6"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%93%81%E6%A1%B6" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 毒马铃薯"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%AF%92%E9%A9%AC%E9%93%83%E8%96%AF"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%AF%92%E9%A9%AC%E9%93%83%E8%96%AF" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 旗帜" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="放置出的旗帜具有轻微摆动的视觉效果。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 超级马铃薯怪" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在25w14craftmine中，吃掉100个毒马铃薯会获得“权威马铃薯杀手”进度，奖励一个超级马铃薯怪奖杯。" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 超级马铃薯怪生物本身没有出现在25w14craftmine中。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 青金石" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在现实中，青金石是一种中等硬度的较稀有石材，被用于制作宝石或作为天然颜料。" />
