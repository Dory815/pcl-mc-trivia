                                Foreground="#4A8CF7" Text="2. 剑"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%89%91"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%89%91" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 铁砧"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%93%81%E7%A0%A7"
