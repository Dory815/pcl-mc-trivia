                                ToolTip="https://zh.minecraft.wiki/w/%E5%8E%BB%E7%9A%AE%E5%8E%9F%E6%9C%A8"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%8E%BB%E7%9A%AE%E5%8E%9F%E6%9C%A8" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 床"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%BA%8A"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%BA%8A" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 远古守卫者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="据Jeb所述，远古守卫者的存在是为了鼓励玩家解出海底神殿的迷宫，而不是直接挖穿它。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 下界疣块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="绯红森林和诡异森林在实装前曾被统称为“下界疣森林”，也许是因为它们生长着由下界疣块和诡异疣块组成的巨型下界菌。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 守卫者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="即使守卫者经由召唤命令等方式被赋予 {NoAI:1} 的标签，它们的眼睛仍然会跟随玩家。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 远古守卫者"
                                ToolTip="https://zh.minecraft.wiki/w/%E8%BF%9C%E5%8F%A4%E5%AE%88%E5%8D%AB%E8%80%85"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E8%BF%9C%E5%8F%A4%E5%AE%88%E5%8D%AB%E8%80%85" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 下界疣块"
                                ToolTip="https://zh.minecraft.wiki/w/%E4%B8%8B%E7%95%8C%E7%96%A3%E5%9D%97"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E4%B8%8B%E7%95%8C%E7%96%A3%E5%9D%97" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 守卫者"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%AE%88%E5%8D%AB%E8%80%85"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%AE%88%E5%8D%AB%E8%80%85" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip5:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 潜影盒" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="潜影盒为俯视顺时针旋转打开、逆时针旋转关闭；基岩版为俯视逆时针旋转打开、顺时针旋转关闭，且旋转速度在接近打开时变慢，接近关闭时变快。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 盔甲" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Java版猪灵和僵尸村民有特殊的盔甲纹理。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 郁金香" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="白色郁金香可用于合成淡灰色染料而非白色染料，是因为在加入郁金香时，白色染料是由骨粉充当的。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 潜影盒"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%BD%9C%E5%BD%B1%E7%9B%92"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%BD%9C%E5%BD%B1%E7%9B%92" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 盔甲"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%9B%94%E7%94%B2"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%9B%94%E7%94%B2" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 郁金香"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%83%81%E9%87%91%E9%A6%99"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%83%81%E9%87%91%E9%A6%99" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 凋灵" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果凋灵受到虚空伤害，它会狂乱地发射蓝色凋灵之首。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 劫掠兽" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="劫掠兽从至少104个方块的高度坠落才会摔死。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 狼" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="下列狼的外观可能参考了现实中的一些犬科或鬣狗科动物：" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 灰狼与现实中的哈士奇相似。" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 黑狼与现实中的黑化灰狼或黑化红狼相似。" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 赭红狼与现实中的埃塞俄比亚狼和豺相似。" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
