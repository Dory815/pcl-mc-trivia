                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 生物" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="铜傀儡是在Minecraft Live 2021生物投票中落选的生物，后在铜器时代中加入游戏，但其功能与初次提及时不同。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 幻翼" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在18w10a发布前，幻翼曾有一个红色版本的纹理，因看起来太像下界生物而被弃用。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 猪" />
