                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 悬挂式告示牌" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="对告示牌和悬挂式告示牌使用荧光墨囊后文本的发光描边，其实是在原文本的图层下偏移生成数个发光文本营造出的假象。游戏总共会渲染文本9次，因此会对性能造成严重的负面影响。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 玩家" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Steve有着与僵尸相似的纹理。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 多重射击" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="多重射击会使射出的箭呈圆形分布（对称轴垂直于玩家所瞄准的方向），至少需要18级的多重射击方能使射出的箭形成一完整的圆形；而当多重射击的等级大于等于18级后，射出的箭会从玩家瞄准方向的反面开始继续增加，与某些箭轨迹贴近。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 悬挂式告示牌"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%82%AC%E6%8C%82%E5%BC%8F%E5%91%8A%E7%A4%BA%E7%89%8C"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%82%AC%E6%8C%82%E5%BC%8F%E5%91%8A%E7%A4%BA%E7%89%8C" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 玩家"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%8E%A9%E5%AE%B6"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8E%A9%E5%AE%B6" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 多重射击"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%A4%9A%E9%87%8D%E5%B0%84%E5%87%BB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%A4%9A%E9%87%8D%E5%B0%84%E5%87%BB" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 冰" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版可以在冰面上点火。如果随机刻过高，会导致水即使不满足部分条件也会异常结冰。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 溺尸" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版能投掷三叉戟的溺尸是特殊的溺尸变种，它们就算失去手中的三叉戟也能够通过投掷三叉戟进行远程攻击，普通溺尸就算获得三叉戟也无法远程攻击，但也会作出投掷三叉戟的动作。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. Minecraft: The Wild Update (Original Game Soundtrack)" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="曲目“Ancestry”虽然也于22w16a或基岩版1.19.0.26与本专辑其他歌曲一同加入，但包含在专辑Minecraft: Caves &amp; Cliffs (Original Game Soundtrack)中，而非本专辑。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 冰"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%86%B0"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%86%B0" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 溺尸"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%BA%BA%E5%B0%B8"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%BA%BA%E5%B0%B8" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. Minecraft: The Wild Update (Original Game Soundtrack)"
                                ToolTip="https://zh.minecraft.wiki/w/Minecraft:_The_Wild_Update_%28Original_Game_Soundtrack%29"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/Minecraft:_The_Wild_Update_%28Original_Game_Soundtrack%29" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip5:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 海龟" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="幼年海龟拥有大量天敌的设定取自现实。现实中的幼年海龟孵化时会引起海滩周遭所有肉食和食腐动物的大规模猎捕，导致其存活率极低。" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 再加上现实中海龟的栖息地遭到破坏和其自身遭到人类的捕杀，海龟现已濒临灭绝。Minecraft制作团队将海龟、北极熊、熊猫、美西螈等受威胁物种加入Minecraft是为了引起玩家对此的关注。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 守卫者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果守卫者被置于1.5格高度的空间内，它能够更快地移动。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 女巫" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版如果一个女巫投掷的喷溅药水击中了另一个女巫，那么被击中的女巫就会进行反击。然而，两个相互敌对的女巫在没有玩家介入的情况下是极难死亡的，因为它们会不停饮用治疗药水，而且魔法抗-{}-性消除了大部分伤害。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 海龟"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%B5%B7%E9%BE%9F"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%B5%B7%E9%BE%9F" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 守卫者"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%AE%88%E5%8D%AB%E8%80%85"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%AE%88%E5%8D%AB%E8%80%85" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 女巫"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%A5%B3%E5%B7%AB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%A5%B3%E5%B7%AB" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 悦灵" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="将紫水晶碎片作为生成悦灵的物品主要考虑到其属于可再生资源，且与其相关的方块紫水晶块和紫水晶母岩能发出适合悦灵的音乐声，这同时也能为紫晶洞增加更多的用处。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 法棍" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="虽然现实中的法棍是一种食品，但游戏中的法棍并不能被直接食用。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
