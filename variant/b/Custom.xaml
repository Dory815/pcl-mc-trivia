                                Foreground="#4A8CF7" Text="1. 铁砧"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%93%81%E7%A0%A7"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%93%81%E7%A0%A7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. TNT"
                                ToolTip="https://zh.minecraft.wiki/w/TNT"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/TNT" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 睡莲"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%9D%A1%E8%8E%B2"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%9D%A1%E8%8E%B2" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 附魔金苹果" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="附魔金苹果必须通过不祥宝库战利品才能实现可再生。这是因为宝库可以被每个玩家打开无限次数，且不祥试炼钥匙是可再生资源。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 劫掠兽" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版可以用生成事件类命令生成带有骑乘者的劫掠兽。如命令命令用于生成有掠夺者骑乘的劫掠兽。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 铁傀儡" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="铁傀儡不会主动进入船或矿车里。但基岩版将在铁轨上的矿车推到铁傀儡处会使铁傀儡进入矿车。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 附魔金苹果"
