                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%A4%B1%E6%B0%B4%E6%81%B6%E9%AD%82" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 台阶" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版当水或熔岩在倒置的台阶上时，滴落的粒子效果会出现在台阶下面的半空中，而不是从台阶本身滴落。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. Minecraft: The Wild Update (Original Game Soundtrack)" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="曲目“Ancestry”虽然也于22w16a或基岩版1.19.0.26与本专辑其他歌曲一同加入，但包含在专辑Minecraft: Caves &amp; Cliffs (Original Game Soundtrack)中，而非本专辑。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 热带鱼（物品）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="热带鱼的纹理没有在纹理更新中被更新。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
