                                Foreground="#4A8CF7" Text="1. 镐"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%95%90"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%95%90" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 牡丹"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%89%A1%E4%B8%B9"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%89%A1%E4%B8%B9" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 鸡骑士"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%B8%A1%E9%AA%91%E5%A3%AB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%B8%A1%E9%AA%91%E5%A3%AB" />
