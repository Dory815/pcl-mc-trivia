                                ToolTip="https://zh.minecraft.wiki/w/%E7%81%B5%E9%AD%82%E6%B2%99"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%81%B5%E9%AD%82%E6%B2%99" />
