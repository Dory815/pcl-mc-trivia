                                Foreground="#4A8CF7" Text="3. 狼"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%8B%BC"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%8B%BC" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip8:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 灵魂沙" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="生物头颅和灵魂沙使用了相同的破碎粒子。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 铁砧" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="铁砧下落所能造成的最大伤害是40，能够杀死同一位置上绝大多数具有满生命值的生物。因此可利用铁砧制作陷阱。" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,4"
                                   Text="· 虽然游戏设定上头盔能减免掉落铁砧造成的伤害，但实际上铁砧是在落地变为方块的瞬间命中生物的脚部碰撞箱而产生伤害。不过装备靴子并不能减免被铁砧砸中造成的伤害。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 饰纹陶罐" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="若使用命令命令将饰纹陶罐放入玩家或一些人形生物的头盔槽，它会像帽子一样出现在头顶，而不像多数方块那样直接框住头部。可在彩蛋了解更多此类彩蛋。" />
