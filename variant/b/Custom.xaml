                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%89%91" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 摄像机" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="摄像机底部的纹理被错误地扭转。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 村民" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="与其他大多数和村民相似的生物不同，村民骑乘其他实体（如矿车和船）时不会显示坐下的动作，这是开发者有意为之的。女巫和流浪商人也是如此。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 铁桶" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="若配方使用水桶、熔岩桶或奶桶作为原材料合成物品，则会返还铁桶，而其他种类的桶不会返还。" />
