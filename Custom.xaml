                                ToolTip="https://zh.minecraft.wiki/w/%E9%BB%91%E8%89%B2%E6%9F%93%E6%96%99"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BB%91%E8%89%B2%E6%9F%93%E6%96%99" />
