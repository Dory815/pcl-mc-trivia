                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 铁砧" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="不同于箭、雪球、鸡蛋投射物一次只能对同一位置的一个生物碰撞箱造成单体伤害，铁砧的落下伤害属于多体伤害，对于命中位置上的所有生物碰撞箱造成全体伤害，原理类似穿透魔咒，但没有伤害数量上限。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 巨人" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="玩家可以使一个刷怪笼生成其他种类的实体，并设定其骑着巨人出现。这样可以绕过生成条件限制生成巨人。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 鸡骑士" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="生成为鸡骑士的幼年僵尸村民被治愈后仍会骑在鸡身上，即使幼年村民成年，甚至转变成女巫也不会主动从鸡身上脱离；基岩版幼年僵尸村民被治愈后就会从鸡身上脱离。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 铁砧"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%93%81%E7%A0%A7"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%93%81%E7%A0%A7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 巨人"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%B7%A8%E4%BA%BA"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%B7%A8%E4%BA%BA" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 鸡骑士"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%B8%A1%E9%AA%91%E5%A3%AB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%B8%A1%E9%AA%91%E5%A3%AB" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 流浪者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="根据Jeb所说的话，流浪者的概念源于Bellevue团队举行的一场Game jam。Jason Major制作出了一堆很酷的生物，他认为流浪者非常适合他们正在计划加入的新生物。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 生物" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="大部分生物在空闲状态下偶尔会看向附近非旁观模式的玩家，部分生物还会看向其他非玩家生物。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 劫掠兽" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在愚人节版本3D Shareware v1.34中，劫掠兽的掉落物是黄色钥匙。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
