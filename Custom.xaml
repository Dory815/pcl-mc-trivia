                                Foreground="#4A8CF7" Text="1. 灵魂火"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%81%B5%E9%AD%82%E7%81%AB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%81%B5%E9%AD%82%E7%81%AB" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 高草丛"
                                ToolTip="https://zh.minecraft.wiki/w/%E9%AB%98%E8%8D%89%E4%B8%9B"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%AB%98%E8%8D%89%E4%B8%9B" />
