                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%BD%9C%E5%BD%B1%E7%9B%92" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 方块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="特定的方块可以通过特殊手段放置在正常手段无法放置的位置里。例如，通过命令或漏洞在空中放置告示牌，它会保持在那个位置，直至其被破坏，或是收到PP更新使其检查自身是否应被破坏。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 煤炭块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="煤炭块不能作为动力矿车的燃料使用。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 猫" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
