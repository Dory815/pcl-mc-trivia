                                Foreground="#4A8CF7" Text="1. 泥砖"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%B3%A5%E7%A0%96"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%B3%A5%E7%A0%96" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
