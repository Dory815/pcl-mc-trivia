        <Grid>
                    <StackPanel Visibility="{variable:Clip1:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 台阶" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版当水或熔岩在倒置的台阶上时，滴落的粒子效果会出现在台阶下面的半空中，而不是从台阶本身滴落。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 书与笔" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="通过辅助程序和编辑器，书与笔最多可以有2,147,483,639页、每页最多32,767字符，还可以修改作者、在标题中添加格式化代码等。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 画" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Kristoffer Zetterstrand亲笔签名、零售估价为3700美元的“燃烧的头骨”原作被赠予了Webhallen Minecraft纹理包大奖赛的冠军Wojciech Mroczek。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 台阶"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%8F%B0%E9%98%B6"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%8F%B0%E9%98%B6" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 书与笔"
                                ToolTip="https://zh.minecraft.wiki/w/%E4%B9%A6%E4%B8%8E%E7%AC%94"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E4%B9%A6%E4%B8%8E%E7%AC%94" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 画"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%94%BB"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%94%BB" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 牡丹" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在现实中，牡丹（Peony）泛指芍药属（Paeonia）的任何开花植物。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 实景视野" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="实景视野的遮盖层在assets文件夹中，文件名为cantseeshitcaptain.png，引自科幻冒险电影《星际迷航》中的迷因。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 行商羊驼" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版自行商羊驼成为独立的生物后，启用来自市场的“Classic Textures”资源包会导致其纹理在游戏中不可见。在此前已作为羊驼生成的行商羊驼不会受到影响。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 牡丹"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%89%A1%E4%B8%B9"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%89%A1%E4%B8%B9" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 实景视野"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%AE%9E%E6%99%AF%E8%A7%86%E9%87%8E"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%AE%9E%E6%99%AF%E8%A7%86%E9%87%8E" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
