                                Foreground="#4A8CF7" Text="2. 沙砾"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%B2%99%E7%A0%BE"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%B2%99%E7%A0%BE" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
