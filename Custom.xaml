                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%B8%A1" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 海晶石" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="“海晶石（prismarine）”是由现在已经删除账号的Reddit用户AjaxGb在Jeb的新方块命名活动上提出的，Jeb看中了这个名称并实现了它。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 美西螈" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Minecraft Live 2020的回顾视频以及洞穴与山崖第一部分的官方预告片中都出现了绿色美西螈，但其并不存在于游戏中。LadyAgnes在一次直播中表示她也无法说出其中的原因。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 奶桶" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="奶桶被数据包的自定义配方作为原材料合成后，也会返还铁桶。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 海晶石"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%B5%B7%E6%99%B6%E7%9F%B3"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%B5%B7%E6%99%B6%E7%9F%B3" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 美西螈"
