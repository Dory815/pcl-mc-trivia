                                ToolTip="https://zh.minecraft.wiki/w/%E9%BE%99%E8%9B%8B"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E9%BE%99%E8%9B%8B" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip10:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 加热块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="加热块的合成配方很有可能取自现实中的一种暖手袋：它们反应缓慢且持续时间长，能够长时间提供适宜的热量。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 水" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="将使用更新抑制得到的下落的含水脚手架送入下界后，水会正常存在，得到更新后流动，原理类似于命令。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 矛" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="无力量效果的玩家使用无附魔的木矛从高空垂直坠落时，仅需下落23刻即可直接击杀另一个无护甲的玩家。" />
