                                Foreground="#4A8CF7" Text="2. 凋灵"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%87%8B%E7%81%B5"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%87%8B%E7%81%B5" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 嘎枝"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%98%8E%E6%9E%9D"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%98%8E%E6%9E%9D" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 水桶" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="水桶被数据包的自定义配方作为原材料合成后，会返还铁桶。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 铜格栅" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="铜格栅与23w13a_or_b中的铜枝叶有相似的设计，不过两者并没有关系。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 铁傀儡" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版铁傀儡拥有其追击动作，但是移动摆臂的优先级更高，因此只有在一起受困无法追击而静止的情况下可以看到。是一种保持右臂上抬左臂后摆的动作。" />
