                    <StackPanel Visibility="{variable:Clip8:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. Minecraft Experience披风" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="这件披风是由Mojang员工Craig Leigh设计的。他的设计灵感来源于蝙蝠侠漫画中的反派角色双面人。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 潜影贝" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="当玩家站在潜影贝的壳上时，可以潜行并且不会掉下来，就像站在方块上一样。如果外壳往侧向打开，则相当于一级垂直的台阶，玩家仍然可以站在上面并且不会掉落下来，除非壳关闭了。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 豹猫" />
