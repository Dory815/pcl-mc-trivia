                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 熔岩"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%86%94%E5%B2%A9"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%86%94%E5%B2%A9" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
