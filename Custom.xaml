                    <StackPanel Visibility="{variable:Clip1:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 梯子" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="与步行、冲刺和游泳时不同的是，在爬梯子的时候，吃食物、用盾牌格挡和拉弓的动作不会使玩家的移动速度减慢。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 羊驼" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="羊驼向狼吐唾沫的行为参考自现实中大羊-{}-驼对郊狼和狗的天生攻击性。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 熔炉" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="熔炉将多种现实设备的功能集于一个方块：锻铁炉、高炉、熔炼炉、转炉和焙烧炉（用于烧炼矿石），熟食炉（用于烘焙和烹饪），炭坑（用于燃烧木头），窑（用于烤制黏土和玻璃）以及精炼炉（用于精炼粗矿）。" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="来源：" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#4A8CF7" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="1. 梯子"
                                ToolTip="https://zh.minecraft.wiki/w/%E6%A2%AF%E5%AD%90"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E6%A2%AF%E5%AD%90" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 羊驼"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%BE%8A%E9%A9%BC"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%BE%8A%E9%A9%BC" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
