                                Foreground="#4A8CF7" Text="1. 刷怪笼"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%88%B7%E6%80%AA%E7%AC%BC"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%88%B7%E6%80%AA%E7%AC%BC" />
