                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%9D%A1%E8%8E%B2" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="2. 矛"
                                ToolTip="https://zh.minecraft.wiki/w/%E7%9F%9B"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E7%9F%9B" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 巨人"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%B7%A8%E4%BA%BA"
