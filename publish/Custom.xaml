    <StackPanel Margin="25,40,23,15">
        <Grid>
                    <StackPanel Visibility="{variable:Clip1:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 下界疣块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="和常见的可以被合成为方块的物品不同，下界疣可以合成下界疣块，但下界疣块不能被拆解成下界疣，故其不能被用来储存下界疣。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：下界疣块（https://zh.minecraft.wiki/w/%E4%B8%8B%E7%95%8C%E7%96%A3%E5%9D%97）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 旗帜" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="考虑到旗帜图案共42种，染料共16种，旗帜共16种，每个旗帜最多可以有6层图案。因此生存模式下可以做出的不重复的旗帜总数理论值为：16 \times \sum_{k=0}^6 (16 \times 42)^k = 1475646641940097552 \approx 1.47 \times 10^{18}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：旗帜（https://zh.minecraft.wiki/w/%E6%97%97%E5%B8%9C）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 僵尸猪灵" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="由猪灵转化而成的僵尸猪灵会保留手中的弩，但它们无法用弩射出箭。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：僵尸猪灵（https://zh.minecraft.wiki/w/%E5%83%B5%E5%B0%B8%E7%8C%AA%E7%81%B5）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 层孔菇" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="若使用命令或基岩版将层孔菇放入玩家或一些人形生物的头盔槽，它会像鸭嘴一样显示于嘴部。可在彩蛋了解更多此类彩蛋。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：层孔菇（https://zh.minecraft.wiki/w/%E5%B1%82%E5%AD%94%E8%8F%87）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 音乐唱片Precipice" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="此唱片中3分10秒至结尾的琶音与“Moog City”的主旋律相似。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：音乐唱片Precipice（https://zh.minecraft.wiki/w/%E9%9F%B3%E4%B9%90%E5%94%B1%E7%89%87Precipice）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 降雪" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版和雨类似，雪最低也能落到虚空里一格（Y=-65）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：降雪（https://zh.minecraft.wiki/w/%E9%99%8D%E9%9B%AA）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 羽毛" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Java版使用命令命令将羽毛放入玩家或一些人形生物的头盔槽会使其直插在后脑勺。可在彩蛋了解更多此类彩蛋。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：羽毛（https://zh.minecraft.wiki/w/%E7%BE%BD%E6%AF%9B）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 末影龙" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Dinnerbone晚些时候表示他认为“Jean?”就是末影龙的官方名称。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末影龙（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E9%BE%99）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 台阶" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版当水或熔岩在倒置的台阶上时，滴落的粒子效果会出现在台阶下面的半空中，而不是从台阶本身滴落。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：台阶（https://zh.minecraft.wiki/w/%E5%8F%B0%E9%98%B6）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 末影珍珠" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="可以使用命令生成抛出的末影珍珠，但它只会显示一个末影珍珠网格并立即消失。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末影珍珠（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E7%8F%8D%E7%8F%A0）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 雪" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版下落的雪作为实体可以被火和熔岩点燃。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：雪（https://zh.minecraft.wiki/w/%E9%9B%AA）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 骡" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在现实中，由于马和驴存在生殖隔离，二者交配后产生的骡也无法正常生育后代。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：骡（https://zh.minecraft.wiki/w/%E9%AA%A1）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip5:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 掠夺者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="掠夺者被添加到村庄和掠夺中是为了给村民一个“真正的”对手，以平衡新的村庄机制。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：掠夺者（https://zh.minecraft.wiki/w/%E6%8E%A0%E5%A4%BA%E8%80%85）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 虫蚀方块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="虽然蠹虫能够进入圆石、石砖和苔石砖，但它们不能进入苔石。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：虫蚀方块（https://zh.minecraft.wiki/w/%E8%99%AB%E8%9A%80%E6%96%B9%E5%9D%97）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 史莱姆" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="玩家可以从大型史莱姆和它分裂的所有史莱姆最高获得28经验：最大的能获得4经验；分裂的最多获得8经验；再次分裂的最多获得16经验（每次分裂为4只）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：史莱姆（https://zh.minecraft.wiki/w/%E5%8F%B2%E8%8E%B1%E5%A7%86）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 悦灵" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="精灵也爱好音乐，其吸引玩家的音效也和背景音乐的声调一致。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：悦灵（https://zh.minecraft.wiki/w/%E6%82%A6%E7%81%B5）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 马" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="玩家骑着马跳跃时，如果头顶的高度不够高，玩家会卡进头顶的方块里，如果此方块是固体方块，玩家会受到伤害。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：马（https://zh.minecraft.wiki/w/%E9%A9%AC）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. Minecraft World" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="该主题乐园最初叫做Minecraft Adventure，并以该名称提交了商标申请，Rabbit&apos;s Foots Studios则以该名称为乐园制作了动画版徽标。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：Minecraft World（https://zh.minecraft.wiki/w/Minecraft_World）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip7:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 硫磺史萊姆" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="这导致通过命令放入部分物品会产生-{}-怪异的效果，如细雪桶被渲染为细雪、发光浆果被渲染为洞穴藤蔓等。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：硫磺史萊姆（https://zh.minecraft.wiki/w/%E7%A1%AB%E7%A3%BA%E5%8F%B2%E8%90%8A%E5%A7%86）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 哞菇" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="简体和台湾繁体中文的“哞-{}-菇”一词是将牛的叫声“哞”和“蘑菇”两个词结合而成的混成词，其对应英文原名“Mooshroom”亦为英文相同含义的“Moo”与“Mushroom”的混成词。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：哞菇（https://zh.minecraft.wiki/w/%E5%93%9E%E8%8F%87）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 铁链" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="铁链仅需使用2个铁粒和1个铁锭合成，但其爆炸抗性却与铁块相当。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：铁链（https://zh.minecraft.wiki/w/%E9%93%81%E9%93%BE）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip8:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 云" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="云的纹理包含了一个向右旋转90°的苦力怕面部图案。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：云（https://zh.minecraft.wiki/w/%E4%BA%91）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 画" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Java版1.17和基岩版1.17.0之前的背面纹理则是修改自Java版1.0.0前木板的纹理，其与正式版至纹理更新前的木板纹理不相对应。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：画（https://zh.minecraft.wiki/w/%E7%94%BB）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 鸡骑士" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="生成为鸡骑士的幼年尸壳和幼年僵尸猪灵（下界传送门生成的除外）所骑乘的鸡一定是热带鸡，因为其只会在热带生物群系生成。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：鸡骑士（https://zh.minecraft.wiki/w/%E9%B8%A1%E9%AA%91%E5%A3%AB）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip9:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 快乐恶魂" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="快乐恶魂的首个概念来自Minecraft Legends中飞行恶魂坐骑的概念艺术。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：快乐恶魂（https://zh.minecraft.wiki/w/%E5%BF%AB%E4%B9%90%E6%81%B6%E9%AD%82）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 沼骸" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="据Felix Jones所说，沼骸的名字“Bogged”来源于一次开发团队被困在厕所里的事情。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：沼骸（https://zh.minecraft.wiki/w/%E6%B2%BC%E9%AA%B8）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 玩家" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Steve在LEGO系列21102 LEGO Minecraft Micro World中与一只苦力怕被设定为微型生物。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：玩家（https://zh.minecraft.wiki/w/%E7%8E%A9%E5%AE%B6）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip10:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. TNT" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="“TNT”的全称是2,4,6-三硝基甲苯（Trinitrotoluene）。虽然游戏内TNT的合成配方是火药和沙子，但现实中TNT是由甲苯与浓硫酸和浓硝酸的混合物长时间加热反应得到的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：TNT（https://zh.minecraft.wiki/w/TNT）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 兔子" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="杀手兔参考自英国喜剧电影《巨蟒与圣杯》中的卡宾诺格的兔子，由@88bully所建议。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：兔子（https://zh.minecraft.wiki/w/%E5%85%94%E5%AD%90）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 剑" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果在创造模式或使用命令为剑附魔效率，用它破坏蜘蛛网的时间将会相应缩短。这是因为剑被归类为采集蜘蛛网的合适工具。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：剑（https://zh.minecraft.wiki/w/%E5%89%91）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip11:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. Mojang办公室披风" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在怪异Mojang办公室派对活动服务器的一张展示活动奖励的图片中，Mojang办公室披风被称为“眼眸花披风”。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：Mojang办公室披风（https://zh.minecraft.wiki/w/Mojang%E5%8A%9E%E5%85%AC%E5%AE%A4%E6%8A%AB%E9%A3%8E）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 甘蔗" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果第2格的甘蔗被破坏，生长时间会重新计算。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：甘蔗（https://zh.minecraft.wiki/w/%E7%94%98%E8%94%97）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 熔岩桶" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="熔岩桶被数据包的自定义配方作为原材料合成后，会返还铁桶。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：熔岩桶（https://zh.minecraft.wiki/w/%E7%86%94%E5%B2%A9%E6%A1%B6）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip12:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 铁栏杆" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="由于铁栏杆的碰撞箱只有1格高，玩家可以直接跳过它们，而不像栅栏那样。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：铁栏杆（https://zh.minecraft.wiki/w/%E9%93%81%E6%A0%8F%E6%9D%86）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 蓝色染料" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="蓝色染料的颜色与格式化代码中的聊天字体颜色相匹配。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：蓝色染料（https://zh.minecraft.wiki/w/%E8%93%9D%E8%89%B2%E6%9F%93%E6%96%99）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 村民" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="虽然村民有屠夫和渔夫职业，但根据繁殖用的食物（面包、胡萝卜、马铃薯、甜菜根）来看，村民可能是素食主义者，肉类食物可能只是为了与玩家交易之用。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：村民（https://zh.minecraft.wiki/w/%E6%9D%91%E6%B0%91）" />
                    </StackPanel>
        </Grid>
