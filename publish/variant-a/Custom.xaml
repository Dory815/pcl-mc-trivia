                                ToolTip="https://zh.minecraft.wiki/w/%E5%B9%B3%E6%BB%91%E7%9F%B3%E5%A4%B4"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%B9%B3%E6%BB%91%E7%9F%B3%E5%A4%B4" />
                            <local:MyTextButton Margin="0,0,8,0" FontSize="11"
                                Foreground="#4A8CF7" Text="3. 冰"
                                ToolTip="https://zh.minecraft.wiki/w/%E5%86%B0"
                                EventType="打开网页" EventData="https://zh.minecraft.wiki/w/%E5%86%B0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 嗅探兽" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="幼年嗅探兽的官方英文名称为“Snifflet”。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 盔甲" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="将盔甲纹理文件调整成半透明后，在游戏中盔甲显示依然是不透明的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 下落的方块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="下落的方块属于实体，因此它们能被爆炸、间歇泉或向上的气泡柱推动。" />
