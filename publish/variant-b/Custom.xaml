    <StackPanel Margin="25,40,23,15">
        <Grid>
                    <StackPanel Visibility="{variable:Clip1:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 奖杯（25w14craftmine）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="超级马铃薯怪是前一年愚人节快照24w14potato中的Boss生物。该生物本身并没有出现在25w14craftmine。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：奖杯（25w14craftmine）（https://zh.minecraft.wiki/w/%E5%A5%96%E6%9D%AF%EF%BC%8825w14craftmine%EF%BC%89）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 金毒马铃薯" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果在创造模式下使用铁砧给金毒马铃薯附魔，金毒马铃薯会显示和附魔金毒马铃薯一样的外观，但食用的效果和金毒马铃薯相同。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：金毒马铃薯（https://zh.minecraft.wiki/w/%E9%87%91%E6%AF%92%E9%A9%AC%E9%93%83%E8%96%AF）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 原木" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="两种菌柄都有动态的纹理，但去皮变种没有。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：原木（https://zh.minecraft.wiki/w/%E5%8E%9F%E6%9C%A8）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 灾厄村民" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="虽然灾厄村民最早出现于Minecraft原版游戏，但它们最初是因Minecraft Dungeons开发过程中对通用反派形象的需求而诞生的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：灾厄村民（https://zh.minecraft.wiki/w/%E7%81%BE%E5%8E%84%E6%9D%91%E6%B0%91）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 粉红凋灵" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在15w14a中，粉红凋灵生成时的爆炸效果会破坏方块并对周围实体造成伤害。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：粉红凋灵（https://zh.minecraft.wiki/w/%E7%B2%89%E7%BA%A2%E5%87%8B%E7%81%B5）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 唱片机" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="使用钻石作为唱片机合成配方的一部分可能是参考了爱迪生留声机使用的钻石指针。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：唱片机（https://zh.minecraft.wiki/w/%E5%94%B1%E7%89%87%E6%9C%BA）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 铁栏杆" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="铁栏杆和床都可以加速僵尸村民的治愈，而这两种方块都常见于牢房。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：铁栏杆（https://zh.minecraft.wiki/w/%E9%93%81%E6%A0%8F%E6%9D%86）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 末地传送门框架" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="摧毁末地传送门框架不会使传送门本身关闭，而基岩版摧毁末地传送门框架会像摧毁下界传送门的框架那样使传送门关闭。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末地传送门框架（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%9C%B0%E4%BC%A0%E9%80%81%E9%97%A8%E6%A1%86%E6%9E%B6）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 加载器Mod" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="模组.jar文件通常存放在.minecraft/mods文件夹中。对于启用了版本隔离功能的启动器，通常位于.minecraft/versions/版本名称/mods。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：加载器Mod（https://zh.minecraft.wiki/w/%E5%8A%A0%E8%BD%BD%E5%99%A8Mod）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 羽毛" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Java版使用命令命令将羽毛放入玩家或一些人形生物的头盔槽会使其直插在后脑勺。可在彩蛋了解更多此类彩蛋。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：羽毛（https://zh.minecraft.wiki/w/%E7%BE%BD%E6%AF%9B）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 黏土" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在现实中，黏土也可以是鲜红色的，并不仅仅局限于蓝灰色。这种颜色在游戏中出现在陶瓦、红砖和花盆的纹理中。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：黏土（https://zh.minecraft.wiki/w/%E9%BB%8F%E5%9C%9F）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 兔子皮" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="兔子皮的第二个纹理是由Reddit用户zeldahuman设计的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：兔子皮（https://zh.minecraft.wiki/w/%E5%85%94%E5%AD%90%E7%9A%AE）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip5:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 掠夺者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版如果掠夺者使用的弩带有魔咒，则只有快速装填和穿透魔咒会生效。如果掠夺者没有装备弩，射箭速度反而会变得更快（能够凭空射箭）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：掠夺者（https://zh.minecraft.wiki/w/%E6%8E%A0%E5%A4%BA%E8%80%85）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 凋灵" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="准确数据为：2.844格高（可变）、3格长、1.719格宽（亦可变）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：凋灵（https://zh.minecraft.wiki/w/%E5%87%8B%E7%81%B5）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 骆驼" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Minecraft中的骆驼是基于现实中的单峰骆驼（Dromedary）开发的，这种骆驼背上只有一个驼峰。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：骆驼（https://zh.minecraft.wiki/w/%E9%AA%86%E9%A9%BC）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 矿车" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在坐着矿车的时候，如果玩家将游戏设置里的声音关掉再打开，那么客户端中这辆矿车将不再发出响声，直到玩家离开矿车。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：矿车（https://zh.minecraft.wiki/w/%E7%9F%BF%E8%BD%A6）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 猫" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在Java版1.14和基岩版1.10.0前，猫是从豹猫驯服而来的，而现实中的猫是从生活在稀树草原等干旱地带的非洲野猫进化而来的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：猫（https://zh.minecraft.wiki/w/%E7%8C%AB）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 平滑石头" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="平滑石头的纹理也被用于红石中继器和红石比较器的侧面和底面纹理。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：平滑石头（https://zh.minecraft.wiki/w/%E5%B9%B3%E6%BB%91%E7%9F%B3%E5%A4%B4）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip7:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 末影人" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="另外，在Minecraft: Story Mode第三章「3」中，当Lukas询问末影人的量词时玩家操纵的角色需要正确指定末影人的集合名词“a haunting of Endermen”（游戏内称“一大群阴魂不散的末影人”）的语法顺序，这支持了Dinnerbone的说法。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末影人（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E4%BA%BA）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 剑" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果在创造模式或使用命令为剑附魔效率，用它破坏蜘蛛网的时间将会相应缩短。这是因为剑被归类为采集蜘蛛网的合适工具。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：剑（https://zh.minecraft.wiki/w/%E5%89%91）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 鞍" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="鞍上适用于盔甲的魔咒都能正常生效。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：鞍（https://zh.minecraft.wiki/w/%E9%9E%8D）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip8:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 史莱姆" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="因为史莱姆的移动速度和它的大小有关，在平地上，8尺寸的史莱姆甚至比没有状态效果影响的玩家还要快。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：史莱姆（https://zh.minecraft.wiki/w/%E5%8F%B2%E8%8E%B1%E5%A7%86）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 村民" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="生成为鸡骑士的幼年僵尸村民被治愈后仍会骑在鸡身上，即使幼年村民成年，甚至转变成女巫也不会主动从鸡身上脱离；基岩版幼年僵尸村民被治愈后就会从鸡身上脱离。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：村民（https://zh.minecraft.wiki/w/%E6%9D%91%E6%B0%91）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 玩家" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在游戏Alone in the park里，Steve是一个可解锁角色，并且拥有一个类似于石镐的射弹。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：玩家（https://zh.minecraft.wiki/w/%E7%8E%A9%E5%AE%B6）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip9:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 强化深板岩" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="尽管游戏中无法获取强化深板岩，在minecraft.net上的文章“创造你的奇妙冒险：荒野奇谭”中却有一条玩家可以挖掘并获取它的故事线。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：强化深板岩（https://zh.minecraft.wiki/w/%E5%BC%BA%E5%8C%96%E6%B7%B1%E6%9D%BF%E5%B2%A9）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 矛" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="玩家速泳时，判定箱高度降低，通常意义上的视线也降低，但矛进行冲锋攻击判定所需的视线不变。因此玩家需要瞄准目标的判定箱下方或身处较低位置才能正常触发冲锋攻击。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：矛（https://zh.minecraft.wiki/w/%E7%9F%9B）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 旗帜" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="出于图案覆盖或与基底同色的原因，上述结果中会有相当一部分旗帜在视觉上难以区分。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：旗帜（https://zh.minecraft.wiki/w/%E6%97%97%E5%B8%9C）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip10:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 生物" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="幻翼、发光鱿鱼、悦灵、嗅探兽和犰狳是通过公众投票加入游戏的生物，这几次投票分别在MINECON Earth 2017、Minecraft Live 2020、Minecraft Live 2021、Minecraft Live 2022和Minecraft Live 2023举行。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：生物（https://zh.minecraft.wiki/w/%E7%94%9F%E7%89%A9）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. Mice on Venus" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="该曲目原本只是一段单人钢琴弹奏短曲，但在随后的Minecraft开发过程中被更改了，加入了一段音乐，成为了现在的Mice on Venus。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：Mice on Venus（https://zh.minecraft.wiki/w/Mice_on_Venus）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 海洋之心" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在基岩版加入海洋之心前，埋藏的宝藏战利品表中曾有一项名为nautilus_core（鹦鹉螺核心）的物品，其后揭晓为海洋之心。然而，海洋之心在大部分游戏文件里仍然被引用为nautilus_core。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：海洋之心（https://zh.minecraft.wiki/w/%E6%B5%B7%E6%B4%8B%E4%B9%8B%E5%BF%83）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip11:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 悦灵" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="悦灵的最初设计“精灵（Wisp）”在Minecraft Dungeons中也有出现。它会在林地监狱中生成，指引玩家寻找秘密区域。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：悦灵（https://zh.minecraft.wiki/w/%E6%82%A6%E7%81%B5）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 唱片残片" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="简体中文的“残片”一词取自音乐游戏《Arcaea》里的同名翻译。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：唱片残片（https://zh.minecraft.wiki/w/%E5%94%B1%E7%89%87%E6%AE%8B%E7%89%87）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 梯子" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果玩家站在梯子下面一格的下半台阶上，玩家要跳跃才能爬上梯子。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：梯子（https://zh.minecraft.wiki/w/%E6%A2%AF%E5%AD%90）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip12:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 海龟鳞甲" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="鳞甲意指鳞片状的生物板甲，现实中有许多生物都有自己的鳞甲结构，例如鳄鱼表皮上的突起物。对海龟而言便是构成龟壳的大板块。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：海龟鳞甲（https://zh.minecraft.wiki/w/%E6%B5%B7%E9%BE%9F%E9%B3%9E%E7%94%B2）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 猪" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果使用命令让部分生物骑猪进入矿车，矿车速度会增加至其在动力铁轨上的速度。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：猪（https://zh.minecraft.wiki/w/%E7%8C%AA）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 动力矿车" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="将原主机版的世界转换为基岩版的世界后，动力矿车会被转换成普通的矿车。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：动力矿车（https://zh.minecraft.wiki/w/%E5%8A%A8%E5%8A%9B%E7%9F%BF%E8%BD%A6）" />
                    </StackPanel>
        </Grid>
