    <StackPanel Margin="25,40,23,15">
        <Grid>
                    <StackPanel Visibility="{variable:Clip1:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 溺尸" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="虽然溺尸不会因为被其他溺尸的三叉戟误伤而互相攻击，但如果僵尸被溺尸的三叉戟误伤，附近没有目标的溺尸会因为支-{}-援僵尸而对该溺尸发动攻击。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：溺尸（https://zh.minecraft.wiki/w/%E6%BA%BA%E5%B0%B8）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 地图" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="使用命令创造的地图如果没有提供有效的地图编号，地图会变成“未知地图”，直到对应地图编号的地图被创建。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：地图（https://zh.minecraft.wiki/w/%E5%9C%B0%E5%9B%BE）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 沉重核心" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="沉重核心必须通过不祥宝库战利品才能实现可再生。这是因为宝库可以被每个玩家打开无限次数，且不祥试炼钥匙是可再生资源。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：沉重核心（https://zh.minecraft.wiki/w/%E6%B2%89%E9%87%8D%E6%A0%B8%E5%BF%83）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 生物" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="幻翼、发光鱿鱼、悦灵、嗅探兽和犰狳是通过公众投票加入游戏的生物，这几次投票分别在MINECON Earth 2017、Minecraft Live 2020、Minecraft Live 2021、Minecraft Live 2022和Minecraft Live 2023举行。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：生物（https://zh.minecraft.wiki/w/%E7%94%9F%E7%89%A9）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 高草丛" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="高草丛不能被直接点燃，然而在其旁边的火却可以传播到它。蔓延到高草丛上方的火看起来是浮空的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：高草丛（https://zh.minecraft.wiki/w/%E9%AB%98%E8%8D%89%E4%B8%9B）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 犰狳" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="生物投票和概念艺术中展示的均是双眼位于头部两侧的犰狳形象，而在最初实装时它的眼睛被移到了正脸，这是因为画师Jasper Boerstra认为如果犰狳的头部正面只有空空的前额，玩家与之交互时就会难以建立起情感纽带。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：犰狳（https://zh.minecraft.wiki/w/%E7%8A%B0%E7%8B%B3）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 时髦的传送门（方块）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="其中文譯名「不界傳送門」也刻意與「地獄傳送門」非常相似。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：时髦的传送门（方块）（https://zh.minecraft.wiki/w/%E6%97%B6%E9%AB%A6%E7%9A%84%E4%BC%A0%E9%80%81%E9%97%A8%EF%BC%88%E6%96%B9%E5%9D%97%EF%BC%89）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 金毒马铃薯" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果在创造模式下使用铁砧给金毒马铃薯附魔，金毒马铃薯会显示和附魔金毒马铃薯一样的外观，但食用的效果和金毒马铃薯相同。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：金毒马铃薯（https://zh.minecraft.wiki/w/%E9%87%91%E6%AF%92%E9%A9%AC%E9%93%83%E8%96%AF）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 末影珍珠" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="可以使用命令生成抛出的末影珍珠，但它只会显示一个末影珍珠网格并立即消失。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末影珍珠（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E7%8F%8D%E7%8F%A0）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 唤魔者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="官网文章“Meet the Evoker”的头图使用了未实装的唤魔者纹理，有着类似于幻术师的兜帽。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：唤魔者（https://zh.minecraft.wiki/w/%E5%94%A4%E9%AD%94%E8%80%85）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 斧" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在Java版中，用斧从超出盾牌有效防御范围的位置对正在举盾的玩家发动近战攻击不会消耗盾牌的耐久度，但仍然可以禁用盾牌5秒并对该玩家造成伤害。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：斧（https://zh.minecraft.wiki/w/%E6%96%A7）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 闪电束" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版由于生成范围的限制，与相比，玩家更容易被闪电束击中。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：闪电束（https://zh.minecraft.wiki/w/%E9%97%AA%E7%94%B5%E6%9D%9F）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip5:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 元素构造器" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="元素构造器界面右边的原子模型是卢瑟福原子结构模型，这是已经被化学界否认的模型，但其结构直观，不失其意义。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：元素构造器（https://zh.minecraft.wiki/w/%E5%85%83%E7%B4%A0%E6%9E%84%E9%80%A0%E5%99%A8）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 掠夺者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="掠夺者比其他的灾厄村民和其他村民略高。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：掠夺者（https://zh.minecraft.wiki/w/%E6%8E%A0%E5%A4%BA%E8%80%85）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 市场" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在Minecoin加入后，玩家仍可使用真实货币支付。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：市场（https://zh.minecraft.wiki/w/%E5%B8%82%E5%9C%BA）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 发光地衣" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果使用调试棒移除发光地衣的所有方块状态，发光地衣会表现为down方块状态均为true时的形态，即附着在一格空间内的6个面上。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：发光地衣（https://zh.minecraft.wiki/w/%E5%8F%91%E5%85%89%E5%9C%B0%E8%A1%A3）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 南瓜" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在基岩版中，南瓜斑块的面积要比Java版中略大。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：南瓜（https://zh.minecraft.wiki/w/%E5%8D%97%E7%93%9C）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 末地传送门框架" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="先放置床再放置末地传送门框架仍然是可行的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末地传送门框架（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%9C%B0%E4%BC%A0%E9%80%81%E9%97%A8%E6%A1%86%E6%9E%B6）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip7:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 末影龙" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Notch还在Reddit论坛解释，由于当时的末影龙存在撞到墙面会转向的弱点，且没有时间再设计一个让它顺利穿过任意地形的AI，于是末影龙拥有了破坏方块的能力。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末影龙（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E9%BE%99）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 村民" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="村民只会主动看着玩家、猫或其他村民，而不会看向其他任何生物（包括铁傀儡）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：村民（https://zh.minecraft.wiki/w/%E6%9D%91%E6%B0%91）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 台阶" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版当水或熔岩在倒置的台阶上时，滴落的粒子效果会出现在台阶下面的半空中，而不是从台阶本身滴落。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：台阶（https://zh.minecraft.wiki/w/%E5%8F%B0%E9%98%B6）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip8:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 凋灵" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="有一幅画上画有灵魂沙和凋灵骷髅头颅搭成的凋灵生成结构，暗示了召唤凋灵的方法。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：凋灵（https://zh.minecraft.wiki/w/%E5%87%8B%E7%81%B5）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 玩家" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在Java版1.14之前，视角被定位在玩家的腿部，因此世界在玩家的视野中应该低于1.8格。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：玩家（https://zh.minecraft.wiki/w/%E7%8E%A9%E5%AE%B6）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 末影人" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="&apos;idle5&apos;听起来像是倒放的“uh oh!”。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末影人（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E4%BA%BA）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip9:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 唱片机" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="唱片机必须通过宝库战利品才能实现可再生。这是因为可用于制造唱片机的钻石同样依赖宝库战利品实现可再生，而宝库可以被每个玩家打开无限次数，且试炼钥匙和不祥试炼钥匙是可再生资源。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：唱片机（https://zh.minecraft.wiki/w/%E5%94%B1%E7%89%87%E6%9C%BA）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. TNT矿车" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="3个TNT矿车互相重叠所造成的爆炸足以将一个满护甲值的玩家炸伤至只剩1生命值。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：TNT矿车（https://zh.minecraft.wiki/w/TNT%E7%9F%BF%E8%BD%A6）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 水" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="旧的水纹理现在仍然可以在assets文件中找到。如果玩家在水下，那么游戏就会在玩家的视角中使用这个纹理。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：水（https://zh.minecraft.wiki/w/%E6%B0%B4）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip10:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 蠹虫" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="愚人节玩笑Java版2.0加入了红石虫，行为与蠹虫相同，会在红石线信号强度快速变化的地方生成。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：蠹虫（https://zh.minecraft.wiki/w/%E8%A0%B9%E8%99%AB）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 末影之眼" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在尚未加入末影之眼的携带版版本中，自然生成的末地传送门框架上有概率生成末影之眼。但这在当时没有任何作用，因为末地尚未被加入到游戏中。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末影之眼（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E4%B9%8B%E7%9C%BC）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 毒马铃薯" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="现实中发芽的马铃薯含有龙葵素，这是一种剧毒物质。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：毒马铃薯（https://zh.minecraft.wiki/w/%E6%AF%92%E9%A9%AC%E9%93%83%E8%96%AF）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip11:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 画" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="“燃烧的头骨”（Skull On Fire）画作的背景是一个能够真正生成的Minecraft世界，其基于作者2010年10月12日13:22:49（UTC+2）于Java版Alpha v1.1.2_01（或更早版本）中截取的截图。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：画（https://zh.minecraft.wiki/w/%E7%94%BB）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 下界石英矿石" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="下界石英矿石在下界大量生成，且会掉落较多的经验，这使得挖掘它成为在Minecraft中获取经验最快的方法之一。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：下界石英矿石（https://zh.minecraft.wiki/w/%E4%B8%8B%E7%95%8C%E7%9F%B3%E8%8B%B1%E7%9F%BF%E7%9F%B3）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 硫黄尖锥" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="玩家和一些人形生物手持硫黄尖锥的方式和手持工具类似。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：硫黄尖锥（https://zh.minecraft.wiki/w/%E7%A1%AB%E9%BB%84%E5%B0%96%E9%94%A5）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip12:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 矮草丛" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="矮草丛有时会稍微偏离它所在的方块，这使大片矮草丛看起来更加自然、不拘束。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：矮草丛（https://zh.minecraft.wiki/w/%E7%9F%AE%E8%8D%89%E4%B8%9B）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 下界疣块" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="绯红森林和诡异森林在实装前曾被统称为“下界疣森林”，也许是因为它们生长着由下界疣块和诡异疣块组成的巨型下界菌。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：下界疣块（https://zh.minecraft.wiki/w/%E4%B8%8B%E7%95%8C%E7%96%A3%E5%9D%97）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. Ancestry" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="该曲目虽然包含在专辑Minecraft: Caves &amp; Cliffs (Original Game Soundtrack)中，但并没有在洞穴与山崖被加入游戏，而是在荒野更新中被加入游戏。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：Ancestry（https://zh.minecraft.wiki/w/Ancestry）" />
                    </StackPanel>
        </Grid>
