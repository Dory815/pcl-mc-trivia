                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：追溯指针（https://zh.minecraft.wiki/w/%E8%BF%BD%E6%BA%AF%E6%8C%87%E9%92%88）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 水" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="旧的水纹理现在仍然可以在assets文件中找到。如果玩家在水下，那么游戏就会在玩家的视角中使用这个纹理。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：水（https://zh.minecraft.wiki/w/%E6%B0%B4）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 超级肥料" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="超级肥料合成材料中的氨和磷可能是现实中氮元素和磷元素对植物作用的体现。然而氨和磷不能直接反应生成可以作为化学肥料的物质。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：超级肥料（https://zh.minecraft.wiki/w/%E8%B6%85%E7%BA%A7%E8%82%A5%E6%96%99）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip12:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 硫磺史萊姆" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="硫方怪对体内方块的渲染实际上是在渲染其动物盔甲槽位所放置的物品作为方块物品时对应的方块。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：硫磺史萊姆（https://zh.minecraft.wiki/w/%E7%A1%AB%E7%A3%BA%E5%8F%B2%E8%90%8A%E5%A7%86）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. TNT" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在流体中的TNT爆炸时无法摧毁方块，但可通过使用沙子或沙砾等受重力影响的方块“覆盖”TNT进行破坏。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：TNT（https://zh.minecraft.wiki/w/TNT）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 黑色染料" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="黑色染料的颜色与格式化代码中的聊天字体颜色相匹配。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
