    <StackPanel Margin="25,40,23,15">
        <Grid>
                    <StackPanel Visibility="{variable:Clip1:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 工作台" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="尽管工作台的原文在早期版本里就已经重命名为“Crafting Table”，仍有不少语言（包括中文在内）将其视为“Workbench”并加以翻译。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：工作台（https://zh.minecraft.wiki/w/%E5%B7%A5%E4%BD%9C%E5%8F%B0）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 斧" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在Java版1.13之前的语言文件中，斧被标记为短柄小斧（Hatchet）。目前斧在海盗语中也被称为“Hatchet”。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：斧（https://zh.minecraft.wiki/w/%E6%96%A7）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 史莱姆" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="玩家可以从大型史莱姆和它分裂的所有史莱姆最高获得28经验：最大的能获得4经验；分裂的最多获得8经验；再次分裂的最多获得16经验（每次分裂为4只）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：史莱姆（https://zh.minecraft.wiki/w/%E5%8F%B2%E8%8E%B1%E5%A7%86）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip2:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 牡丹" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在现实中，牡丹（Peony）泛指芍药属（Paeonia）的任何开花植物。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：牡丹（https://zh.minecraft.wiki/w/%E7%89%A1%E4%B8%B9）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 铁轨" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在一连串转弯的普通铁轨上行驶比动力铁轨更快。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：铁轨（https://zh.minecraft.wiki/w/%E9%93%81%E8%BD%A8）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 弩" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版蜘蛛网可以困住用弩发射的烟花火箭，并使其在蜘蛛网中爆裂。只需一格的蜘蛛网就可以阻止飞行时间为3的烟花火箭通过。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：弩（https://zh.minecraft.wiki/w/%E5%BC%A9）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip3:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 冰弹" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在水下扔冰弹会将玩家困在冰里。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：冰弹（https://zh.minecraft.wiki/w/%E5%86%B0%E5%BC%B9）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 远古残骸" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="远古残骸是所有可烧炼物中产生经验最多的。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：远古残骸（https://zh.minecraft.wiki/w/%E8%BF%9C%E5%8F%A4%E6%AE%8B%E9%AA%B8）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 狼" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="狼可传送到碰撞箱不完整方块上。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：狼（https://zh.minecraft.wiki/w/%E7%8B%BC）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip4:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 降雨" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="雨在云层上也会存在。Notch的解释是云层之上的灰色区域才是雨真正的来源。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：降雨（https://zh.minecraft.wiki/w/%E9%99%8D%E9%9B%A8）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 书架" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="制作15个书架来得到一个30级的附魔台需要花费90块木板、45个皮革和135张纸。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：书架（https://zh.minecraft.wiki/w/%E4%B9%A6%E6%9E%B6）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 末地传送门框架" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版末地传送门框架下方三格不能放置床。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末地传送门框架（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%9C%B0%E4%BC%A0%E9%80%81%E9%97%A8%E6%A1%86%E6%9E%B6）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip5:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 末影人" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="末影人会被末影龙冲撞而伤到，因而被其激怒并试图攻击末影龙，此时如果玩家注视末影人，末影人会短暂地恢复至非敌对状态。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末影人（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E4%BA%BA）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 黑曜石" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="黑曜石的硬度和爆炸抗性极高，但又较容易获取，这使黑曜石成为有效的防御方块，它在多人游戏服务器的许多基地中被用作防御破坏者的手段。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：黑曜石（https://zh.minecraft.wiki/w/%E9%BB%91%E6%9B%9C%E7%9F%B3）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 铁砧" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="可利用这个特性低成本获得物品分类器的填充物。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：铁砧（https://zh.minecraft.wiki/w/%E9%93%81%E7%A0%A7）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip6:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 旗帜" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="考虑到旗帜图案共42种，染料共16种，旗帜共16种，每个旗帜最多可以有6层图案。因此生存模式下可以做出的不重复的旗帜总数理论值为：16 \times \sum_{k=0}^6 (16 \times 42)^k = 1475646641940097552 \approx 1.47 \times 10^{18}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：旗帜（https://zh.minecraft.wiki/w/%E6%97%97%E5%B8%9C）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 遮光玻璃" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="现实中有些遮光玻璃是采用紫水晶和玻璃混合融制的紫晶玻璃，色泽较深甚至偏紫。其对于紫外线有良好的过滤效果，因此具有遮光性。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：遮光玻璃（https://zh.minecraft.wiki/w/%E9%81%AE%E5%85%89%E7%8E%BB%E7%92%83）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 村民" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在Minecraft官方账号的幼年生物新外观宣传视频中，幼年村民出现了模型错误。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：村民（https://zh.minecraft.wiki/w/%E6%9D%91%E6%B0%91）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip7:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 火焰弹" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版当装有火焰弹的发射器前方有某些方块时，火焰会在该方块另一侧出现。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：火焰弹（https://zh.minecraft.wiki/w/%E7%81%AB%E7%84%B0%E5%BC%B9）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 蓝色染料" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="蓝色染料的颜色与格式化代码中的聊天字体颜色相匹配。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：蓝色染料（https://zh.minecraft.wiki/w/%E8%93%9D%E8%89%B2%E6%9F%93%E6%96%99）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 市场" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="地圖《Beyond：Platformer》聲稱獲得了「鑽石推薦」獎，並稱讚其「創新與樂趣！」。目前尚無其他獲此獎者。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：市场（https://zh.minecraft.wiki/w/%E5%B8%82%E5%9C%BA）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip8:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 北极熊" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="与大多数可繁殖生物的幼年个体不同，幼年北极熊的音效不完全是成年北极熊音效的加速版，而较为独特。这一点也反映在字幕中。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：北极熊（https://zh.minecraft.wiki/w/%E5%8C%97%E6%9E%81%E7%86%8A）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 微光钥匙" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="微光钥匙看似是不祥试炼钥匙的重绘版本，但它只有1个头部（而非3个），整体呈蓝色，外观少了几分“邪恶感”。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：微光钥匙（https://zh.minecraft.wiki/w/%E5%BE%AE%E5%85%89%E9%92%A5%E5%8C%99）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 铁链" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="铁链仅需使用2个铁粒和1个铁锭合成，但其爆炸抗性却与铁块相当。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：铁链（https://zh.minecraft.wiki/w/%E9%93%81%E9%93%BE）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip9:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 玩家" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="在LEGO Club杂志的2016年7-8月刊中，提到Steve是Alex的男朋友，以及Steve是一个矿工、建筑师和炼金术士，而Alex则是一个建筑师、探险家和猎人。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：玩家（https://zh.minecraft.wiki/w/%E7%8E%A9%E5%AE%B6）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 剑" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="如果在创造模式或使用命令为剑附魔效率，用它破坏蜘蛛网的时间将会相应缩短。这是因为剑被归类为采集蜘蛛网的合适工具。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：剑（https://zh.minecraft.wiki/w/%E5%89%91）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 末影龙" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Dinnerbone晚些时候表示他认为“Jean?”就是末影龙的官方名称。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：末影龙（https://zh.minecraft.wiki/w/%E6%9C%AB%E5%BD%B1%E9%BE%99）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip10:Visible}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 掠夺者" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="作為突襲隊長的掠奪者亦會拾起旗幟，即使其頭上已有不祥旗幟，其行為與一般的掠奪者相同。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：掠夺者（https://zh.minecraft.wiki/w/%E6%8E%A0%E5%A4%BA%E8%80%85）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 幻术师" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="与掠夺者相似，通过命令使幻术师手中没有弓时，幻术师将无法进行攻击，但仍然能吟诵咒语。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：幻术师（https://zh.minecraft.wiki/w/%E5%B9%BB%E6%9C%AF%E5%B8%88）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 马鞍" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="游戏里的马鞍与DrZhark制作的Mo&apos; Creatures Mod中的马鞍具有相同的纹理，因为DrZhark参与了游戏中马的开发。该物品也有着和游戏中的马鞍相同的配方和翻译。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：马鞍（https://zh.minecraft.wiki/w/%E9%A9%AC%E9%9E%8D）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip11:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 花盆" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="和基岩版中的花盆内部纹理分别取自泥土纹理中心的4×4和6×6像素。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：花盆（https://zh.minecraft.wiki/w/%E8%8A%B1%E7%9B%86）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 凋灵" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="基岩版凋灵出生时的无敌状态不免疫虚空伤害。若在它解放前对它造成虚空伤害，并导致血条在半血以下时，凋灵会拥有凋灵护甲，但解放后消失。这样就能获得一个全程只有一阶段，但是位移前的准备时间从2秒升为4秒的凋灵了。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：凋灵（https://zh.minecraft.wiki/w/%E5%87%8B%E7%81%B5）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 染色强化玻璃" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="染色强化玻璃的合成配方很可能取自现实中离子交换工艺的方法，这种玻璃强化的方法能够很大程度提高玻璃抵御外力破坏的能力。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：染色强化玻璃（https://zh.minecraft.wiki/w/%E6%9F%93%E8%89%B2%E5%BC%BA%E5%8C%96%E7%8E%BB%E7%92%83）" />
                    </StackPanel>
                    <StackPanel Visibility="{variable:Clip12:Collapsed}">
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="1. 骆驼" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="与现实一致，骆驼行走时的动画中同侧前腿和后腿摆动方向相同（即“顺拐”）。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：骆驼（https://zh.minecraft.wiki/w/%E9%AA%86%E9%A9%BC）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="2. 骷髅" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="多重射击附魔在骷髅的弓上不起作用，但穿透附魔会正常生效。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：骷髅（https://zh.minecraft.wiki/w/%E9%AA%B7%E9%AB%85）" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                                   Text="3. 书与笔" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="通过辅助程序和编辑器，书与笔最多可以有2,147,483,639页、每页最多32,767字符，还可以修改作者、在标题中添加格式化代码等。" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="来源：书与笔（https://zh.minecraft.wiki/w/%E4%B9%A6%E4%B8%8E%E7%AC%94）" />
                    </StackPanel>
        </Grid>
